{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallpaper Switcher",
  "version": "0.1.0",
  "identifier": "com.local.wallpaperswitcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wallpaper Switcher",
        "width": 860,
        "height": 620,
        "minWidth": 680,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../res/1.png": "res/1.png",
      "../res/2.png": "res/2.png",
      "../res/3.png": "res/3.png"
    }
  }
}
